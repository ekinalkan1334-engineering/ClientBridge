# --- PostgreSQL (docker-compose bu değerleri kullanır) ---
POSTGRES_USER=clientbridge
POSTGRES_PASSWORD=clientbridge
POSTGRES_DB=clientbridge

# Docker içinde host "db"; Docker dışında çalıştırırsan "localhost" yap.
DATABASE_URL=postgresql+asyncpg://clientbridge:clientbridge@db:5432/clientbridge

# --- CRM (şimdilik kendi mock endpoint'imiz) ---
CRM_BASE_URL=http://api:8000
CRM_ORDERS_PATH=/mock/crm/orders
CRM_TIMEOUT_SECONDS=10

# --- Worker ayarları ---
WORKER_CONCURRENCY=4
POLL_INTERVAL_SECONDS=2
HEARTBEAT_INTERVAL_SECONDS=15
RECOVERY_INTERVAL_SECONDS=60
HEARTBEAT_TIMEOUT_SECONDS=300
MAX_RETRIES=5
BACKOFF_BASE_SECONDS=2
BACKOFF_MAX_SECONDS=300
